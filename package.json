{
  "name": "todo-app",
  "version": "1.0.0",
  "description": "Simple to-do app with Node.js, Express, and PostgreSQL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate:status": "node scripts/migration-status.js",
    "migrate:create": "node scripts/create-migration.js",
    "migrate:up": "node-pg-migrate up -m migrations",
    "migrate:down": "node-pg-migrate down -m migrations",
    "migrate:redo": "node-pg-migrate redo -m migrations",
    "migrate:history": "node scripts/migration-history.js"
  },
  "keywords": [
    "todo",
    "express",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "node-pg-migrate": "^8.0.4",
    "nodemon": "^3.0.1"
  }
}
